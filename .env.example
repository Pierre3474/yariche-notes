# Copier en .env puis adapter. Toutes les variables sont facultatives :
# sans rien, Yariche démarre en local sans connexion (un seul utilisateur).

# --- Serveur ---------------------------------------------------------------------
# Port publié par docker compose (le conteneur écoute toujours sur 5174)
YARICHE_PORT=5174
# Nom du premier coffre créé (dossier data/vaults/<nom>)
DEFAULT_VAULT=Notes
# Propriétaire des notes ajoutées hors de Yariche (Nextcloud, Obsidian, Finder…)
# YARICHE_DEFAULT_OWNER=toi@exemple.fr
# Administrateurs (changer de coffre, connecter Nextcloud), séparés par des virgules.
# Sans cette variable : la première personne qui se connecte.
# ADMIN_EMAILS=toi@exemple.fr

# --- Connexion ---------------------------------------------------------------------------
# local : comptes Yariche (page de connexion intégrée, premier compte créé sur /setup)
# oidc  : SSO seul (variables OIDC_* ci-dessous)
# both  : comptes Yariche et SSO ensemble
# none  : aucune connexion, tout le monde est DEV_USER_EMAIL (ta propre machine seulement)
# Sans AUTH_MODE : SSO si OIDC_* est renseigné, sinon aucune connexion.
# install.sh écrit AUTH_MODE=local, SESSION_SECRET et SETUP_CODE pour toi.
# AUTH_MODE=local
# Code demandé sur /setup pour créer le premier compte (évite qu'un tiers le crée avant toi)
# SETUP_CODE=
# Inscription libre sur /signup (false : seul l'administrateur ajoute des comptes)
# ALLOW_SIGNUP=false
# Ajoute le formulaire de compte local à un SSO déjà configuré
# LOCAL_LOGIN=1
#
# SSO OpenID Connect
# OIDC_ISSUER=https://auth.exemple.fr/application/o/yariche/
# OIDC_CLIENT_ID=yariche
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://notes.exemple.fr/auth/callback
# OIDC_PROVIDER_NAME=Authentik
# Comptes qui peuvent se connecter (email ou identifiant SSO), séparés par des virgules.
# Vide : tout compte du SSO. Les autres travaillent par liens de partage, sans compte.
# ALLOWED_EMAILS=toi@exemple.fr
# Autre compte SSO de la même personne (ex. compte d'administration) : connecté comme
# le compte principal (mêmes pages). Paires « alias=compte », séparées par des virgules.
# ACCOUNT_ALIASES=toi.admin=toi@exemple.fr
# Chaîne aléatoire longue (openssl rand -hex 32), obligatoire avec le SSO
# SESSION_SECRET=
# DEV_USER_EMAIL=dev@local
# DEV_USER_NAME=Dev Local

# --- Nextcloud ---------------------------------------------------------------------------
# Où vivent les notes :
#   ask        (défaut) premier lancement : connexion à Nextcloud proposée, ou notes sur ce serveur
#   nextcloud  toujours dans un dossier Nextcloud (le serveur n'en garde qu'une copie de travail)
#   local      sur ce serveur uniquement, sans Nextcloud
# YARICHE_STORAGE=nextcloud
# Adresse proposée au premier lancement. La connexion se fait ensuite dans le navigateur
# (comme les applications Nextcloud) : rien d'autre à configurer.
# NEXTCLOUD_URL=https://cloud.exemple.fr
# Sans interface : compte fixe (mot de passe d'application : Paramètres → Sécurité)
# NEXTCLOUD_USER=
# NEXTCLOUD_APP_PASSWORD=
# Intervalle de synchronisation (secondes, 30 par défaut)
# NEXTCLOUD_SYNC_INTERVAL=30
# Certificat auto-signé
# NEXTCLOUD_TRUST_SELF_SIGNED=1

# --- Assistant IA (facultatif) ------------------------------------------------------
# N'importe quelle API compatible OpenAI : LiteLLM, Ollama (http://ollama:11434),
# vLLM, OpenAI (https://api.openai.com)…
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen3:30b-a3b
# LLM_API_KEY=
